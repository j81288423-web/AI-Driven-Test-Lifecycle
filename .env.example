# SECURITY_NOTE: committed template only. Copy to .env and fill real values locally / via CI secret store.
# Never commit real credentials, tokens, or internal URLs.

# Target application entry point (must be https:// so TLS is enforced).
BASE_URL=https://practice.expandtesting.com

# Active environment key resolved against config/environments.config.json.
TEST_ENV=demo

# Set to false to watch the browser locally; CI should leave this true.
HEADLESS=true

# Credentials are resolved from the environment only - keep placeholders here.
TEST_USERNAME=<REPLACE_ME>
TEST_PASSWORD=<REPLACE_ME>
